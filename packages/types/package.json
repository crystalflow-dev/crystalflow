{
  "name": "@crystalflow/types",
  "version": "0.1.0",
  "description": "TypeScript type definitions for CrystalFlow",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "types",
    "typescript",
    "crystalflow"
  ],
  "author": "CrystalFlow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crystalflow-dev/crystalflow.git",
    "directory": "packages/types"
  },
  "homepage": "https://crystalflow.dev",
  "bugs": "https://github.com/crystalflow-dev/crystalflow/issues",
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
