{
  "name": "@crystalflow/core",
  "version": "0.1.0",
  "description": "Core workflow engine for CrystalFlow",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "cd ../.. && npm test -- --testPathPatterns=packages/core",
    "test:watch": "cd ../.. && npm test -- --testPathPatterns=packages/core --watch",
    "test:benchmark": "cd ../.. && npm test -- --testPathPatterns=packages/core/src/__tests__/benchmarks --testTimeout=60000",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "workflow",
    "workflow-engine",
    "node-system",
    "execution"
  ],
  "author": "CrystalFlow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crystalflow-dev/crystalflow.git",
    "directory": "packages/core"
  },
  "homepage": "https://crystalflow.dev",
  "bugs": "https://github.com/crystalflow-dev/crystalflow/issues",
  "dependencies": {
    "@crystalflow/types": "^0.1.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
