{
  "name": "@crystalflow/react",
  "version": "0.1.0",
  "description": "React components for CrystalFlow workflow builder",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "react",
    "workflow",
    "workflow-builder",
    "node-editor",
    "react-flow"
  ],
  "author": "CrystalFlow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crystalflow-dev/crystalflow.git",
    "directory": "packages/react"
  },
  "homepage": "https://crystalflow.dev",
  "bugs": "https://github.com/crystalflow-dev/crystalflow/issues",
  "dependencies": {
    "@crystalflow/core": "^0.1.0",
    "@crystalflow/types": "^0.1.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-a11y": "^10.2.0",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/addon-vitest": "^10.2.0",
    "@storybook/react-vite": "^10.2.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@xyflow/react": "^12.10.0",
    "eslint-plugin-storybook": "^10.2.0",
    "playwright": "^1.58.0",
    "storybook": "^10.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.10.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
