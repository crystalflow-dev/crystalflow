{
  "name": "reactflo-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "A declarative workflow builder framework",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces --if-present",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-storybook": "^10.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^1.7.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "workflow",
    "workflow-builder",
    "node-editor",
    "visual-programming",
    "react",
    "typescript",
    "framework"
  ],
  "author": "ReactFlo Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fladeed/reactflo.git"
  },
  "bugs": {
    "url": "https://github.com/Fladeed/reactflo/issues"
  },
  "homepage": "https://github.com/Fladeed/reactflo#readme"
}
